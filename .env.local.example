# Copy to .env.local and fill in. Then, in any terminal:
#
#     source .env.local
#     .venv/bin/python tools/fetch-social.py --discover
#
# .env.local is gitignored. Do not paste these values into email, chat, or
# anywhere else — regenerating one takes two minutes, cleaning up a leaked one
# does not.

export FB_TOKEN=""      # the extended Page token
export FB_PAGE_ID=""    # numeric, from --discover
export IG_USER_ID=""    # numeric, from --discover
