---
# The web app manifest. A template so that the name comes from _config.yml
# like everywhere else: the Aikikai Barcelona rename must stay at three files.
# Icons: tools/make-favicons.py. "any" is the rounded tile; "maskable" is full
# bleed with the knot inside the 80% safe circle, for launchers that crop.
layout: null
sitemap: false
---
{
  "name": {{ site.title | jsonify }},
  "short_name": {{ site.title | jsonify }},
  "description": {{ site.description | strip | jsonify }},
  "lang": "es",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#111314",
  "background_color": "#111314",
  "icons": [
    { "src": "/icons/musubi2-app-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/musubi2-app-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/musubi2-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/musubi2-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
