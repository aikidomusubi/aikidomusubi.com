_site
.DS_Store
.jekyll-metadata
.sass-cache
/node_modules
site_links
site_links_outdated
package.json
package-lock.json

# Unsubset source faces for tools/subset-ja-fonts.py — ~4.8 MB of input that
# never ships. Re-fetch per tools/ja-font-sources/README.md when the script
# needs them; the subset output in /fonts/ is what is committed.
tools/ja-font-sources/*.woff2

# Python virtualenv for tools/fetch-social.py (see docs/meta-setup.md)
.venv/
# Meta tokens for tools/fetch-social.py. Never committed — a token is a
# password, and this file is the place to keep one.
.env.local
.env

# Working directory for files handed over mid-session (posters, PDFs, logos)
# before they are converted into /images, /files or /graphics. Inputs only.
temp/

# Verification screenshots from the mockup passes: 37 MB of PNGs that nothing
# renders from. The approved mockups themselves — the HTML and the generators
# in docs/mockups/src — ARE committed, per the note in CLAUDE.md about losing
# the whole set once.
docs/mockups/renders/
__pycache__/

# ---------------------------------------------------------------------------
# Local-only, machine-specific, and never wanted in a public repo
#
# NOTE, because it is the thing people get wrong about this file: .gitignore
# only stops something being ADDED. It does not hide, remove or unpublish
# anything that has already been committed — that stays in the repository and
# in its history until somebody deliberately takes it out. Everything below was
# never tracked, which is why adding it here costs nothing.
# ---------------------------------------------------------------------------

# Claude Code's per-machine settings: permission allowlists and local paths.
# `.claude/dev-start.sh` IS tracked on purpose — it is the shared dev-start
# script and CLAUDE.md documents it.
.claude/settings.local.json

# Editors and operating systems
.vscode/
.idea/
*.swp
*.swo
*~
Thumbs.db
Desktop.ini

# Logs and crash droppings from the toolchain
*.log
npm-debug.log*
yarn-error.log*
.eslintcache

# Scratch space. Anything here is working material, not the site.
scratch/
scratchpad/
*.bak
*.orig
*.rej
